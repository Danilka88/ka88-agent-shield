# ka88-agent-shield - Configuration Template
# Copy this file to .env and customize as needed

# ============================================================================
# LM STUDIO CONFIGURATION
# ============================================================================

# LM Studio server URL (default)
LM_STUDIO_URL=http://localhost:1234/v1

# Model name for scanning
MODEL=qwen3-35b-a3b

# Connection timeout to LM Studio (seconds)
TIMEOUT_LM_STUDIO=5

# ============================================================================
# SCAN LIMITS
# ============================================================================

# Maximum file size for scanning (bytes)
# Default: 10MB = 10485760
MAX_FILE_SIZE=10485760

# Maximum number of files to scan
MAX_FILES=1000

# Scan timeout (seconds)
MAX_SCAN_TIME=300

# ============================================================================
# EXCLUSIONS
# ============================================================================

# Directories excluded from scanning (space-separated)
EXCLUDE_DIRS="node_modules .venv venv dist build .git __pycache__"

# ============================================================================
# LOGGING
# ============================================================================

# Debug level (0 or 1)
DEBUG=0

# ============================================================================
# PATHS
# ============================================================================

# Path to skill-scanner virtual environment
# VENV_PATH=~/.ka88-agent-shield/.venv

# ============================================================================
# SKILL-SCANNER OPTIONS
# ============================================================================

# Scan policy: strict, balanced, permissive
SCAN_POLICY=balanced

# Use LLM analysis (requires LM Studio)
USE_LLM=true

# Use behavioral analysis
USE_BEHAVIORAL=true